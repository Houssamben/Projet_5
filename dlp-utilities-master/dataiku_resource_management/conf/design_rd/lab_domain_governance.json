{
  "domain_groups": {
    "contributor_group": "{domain_code}_Contributor"
  },
  "domain_groups_permissions": {
    "admin": false,
    "mayManageUDM": false,
    "mayCreateProjects": false,
    "mayCreateProjectsFromMacros": false,
    "mayCreateProjectsFromTemplates": false,
    "mayCreateProjectsFromDataikuApps": false,
    "mayWriteUnsafeCode": false,
    "mayWriteSafeCode": false,
    "mayCreateAuthenticatedConnections": false,
    "mayCreateCodeEnvs": false,
    "mayCreateClusters": false,
    "mayCreateCodeStudioTemplates": false,
    "mayDevelopPlugins": false,
    "mayEditLibFolders": false,
    "mayManageCodeEnvs": false,
    "mayManageClusters": false,
    "mayManageCodeStudioTemplates": false,
    "mayViewIndexedHiveConnections": false,
    "mayCreatePublishedAPIServices": false,
    "mayCreatePublishedProjects": false,
    "mayWriteInRootProjectFolder": false,
    "mayCreateActiveWebContent": false,
    "mayCreateWorkspaces": false,
    "mayShareToWorkspaces": false,
    "mayCreateDataCollections": false,
    "mayPublishToDataCollections": false,
    "mayManageFeatureStore": false,
    "canObtainAPITicketFromCookiesForGroupsRegex": ""
  },
  "domain_folder_permissions": [
    {
      "group": "{contributor_group}",
      "admin": false,
      "read": true,
      "writeContents": true
    }
  ],
  "cos_connections_permissions": {
    "allowedGroups": [
      "Admin",
      "ITOps",
      "SRE",
      "administrators",
      "{contributor_group}"
    ],
    "detailsReadableByGroups": [
      "Admin",
      "ITOps",
      "SRE",
      "administrators",
      "{contributor_group}"
    ]
  },
  "db_connections_permissions": {
    "allowedGroups": [
      "Admin",
      "ITOps",
      "SRE",
      "administrators",
      "{contributor_group}"
    ],
    "detailsReadableByGroups": [
      "Admin",
      "ITOps",
      "SRE",
      "administrators"
    ]
  },
  "shared_cos_connections_permissions": {
    "allowedGroups": [
      "{contributor_group}"
    ],
    "detailsReadableByGroups": [
      "{contributor_group}"
    ]
  },
  "shared_db_connections_permissions": {
    "allowedGroups": [
      "{contributor_group}"
    ],
    "detailsReadableByGroups": []
  },
  "shared_data_collection_permissions": [
      {"group": "{contributor_group}", "admin": false, "read": true, "write": false}
  ],
  "code_env_permissions": [
      {"group": "{contributor_group}", "update": true, "use": true, "manageUsers": false}
  ]
}