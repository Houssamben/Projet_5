{
  "cos_connection": {
    "params": {
      "defaultManagedPath": "{managed_data_subpath}",
      "regionOrEndpoint": "{endpoint}",
      "hdfsInterface": "S3A",
      "encryptionMode": "NONE",
      "chbucket": "{bucket}",
      "chroot": "{path_in_bucket}",
      "switchToRegionFromBucket": false,
      "usePathMode": false,
      "metastoreSynchronizationMode": "NO_SYNC",
      "dkuProperties": [
        {
          "name": "vaultUrl",
          "value": "https://hvault.staging.echonet",
          "secret": false
        },
        {
          "name": "vaultNamespace",
          "value": "BNPPLG_LEASING/5004/{ecosystem}",
          "secret": false
        },
        {
          "name": "vaultSecretPath",
          "value": "objsto/data/{cos}",
          "secret": false
        },
        {
          "name": "codeAp",
          "value": "{ap_code}",
          "secret": false
        }
      ],
      "namingRule": {
        "pathDatasetNamePrefix": ""
      },
      "credentialsMode": "KEYPAIR",
      "accessKey": "{accessKey}",
      "secretKey": "{secretKey}",
      "customAWSCredentialsProviderParams": []
    },
    "allowWrite": true,
    "allowManagedDatasets": true,
    "allowManagedFolders": true,
    "useGlobalProxy": false,
    "maxActivities": 0,
    "customFields": {},
    "credentialsMode": "GLOBAL",
    "customBasicConnectionCredentialProviderParams": [],
    "usableBy": "ALLOWED",
    "allowedGroups": [
      "Admin",
      "ITOps",
      "SRE",
      "Data_Engineer",
      "MLOps",
      "administrators"
    ],
    "detailsReadability": {
      "readableBy": "ALLOWED",
      "allowedGroups": [
        "Admin",
        "ITOps",
        "SRE",
        "Data_Engineer",
        "MLOps",
        "administrators"
      ]
    }
  },
  "db_connection": {
    "params": {
      "PostgreSQL": {
        "driverMode": "MANAGED",
        "port": "{port}",
        "postGISenabled": true,
        "host": "{host}",
        "user": "{user}",
        "password": "{password}",
        "db": "{db}",
        "useURL": false,
        "namingRule": {
          "tableNameDatasetNamePrefix": "",
          "canOverrideCatalogInManagedDatasetCreation": false,
          "schemaName": "{schema}",
          "canOverrideSchemaInManagedDatasetCreation": false
        },
        "useTruncate": false,
        "autocommitMode": false,
        "properties": [],
        "dkuProperties": [
          {
            "name": "vaultUrl",
            "value": "https://hvault-b.group.echonet",
            "secret": false
          },
          {
            "name": "vaultNamespace",
            "value": "{AP_Code}",
            "secret": false
          },
          {
            "name": "vaultSecretPath",
            "value": "database/creds/own_{resource}_{trigram}",
            "secret": false
          },
          {
            "name": "codeAp",
            "value": "{AP_Code}",
            "secret": false
          }
        ],
        "useAsMetastoreSource": false,
        "metastoreSourceType": "SPARKSQL_THRIFT",
        "sendDriverJarsToSpark": false,
        "connectionPoolSettings": {
          "enabled": false,
          "testOnBorrow": true,
          "minEvictableIdleTimeSeconds": 600,
          "timeBetweenEvictionRunsSeconds": 180,
          "maxActive": -1,
          "maxIdle": 8,
          "validationTimeoutSeconds": 5
        }
      },
      "Oracle": {
        "kerberosLoginEnabled": false,
        "user": "{user}",
        "password": "{password}",
        "useURL": true,
        "url": "{connection_url}",
        "displayedUrl": "{displayed_url}",
        "fetchSize": "50000",
        "namingRule": {
          "tableNameDatasetNamePrefix": "",
          "canOverrideCatalogInManagedDatasetCreation": false,
          "canOverrideSchemaInManagedDatasetCreation": false
        },
        "useTruncate": false,
        "autocommitMode": false,
        "properties": [],
        "dkuProperties": [],
        "useAsMetastoreSource": false,
        "metastoreSourceType": "SPARKSQL_THRIFT",
        "sendDriverJarsToSpark": true,
        "connectionPoolSettings": {
          "enabled": false,
          "testOnBorrow": true,
          "minEvictableIdleTimeSeconds": 600,
          "timeBetweenEvictionRunsSeconds": 180,
          "maxActive": -1,
          "maxIdle": 8,
          "validationTimeoutSeconds": 5
        }
      }
    },
    "allowWrite": false,
    "allowManagedDatasets": false,
    "allowManagedFolders": false,
    "useGlobalProxy": false,
    "maxActivities": 0,
    "customFields": {},
    "credentialsMode": "GLOBAL",
    "customBasicConnectionCredentialProviderParams": [],
    "usableBy": "ALLOWED",
    "allowedGroups": [
      "Admin",
      "ITOps",
      "SRE",
      "Data_Engineer",
      "MLOps",
      "administrators"
    ],
    "detailsReadability": {
      "readableBy": "ALLOWED",
      "allowedGroups": [
        "Admin",
        "ITOps",
        "SRE",
        "Data_Engineer",
        "MLOps",
        "administrators"
      ]
    }
  }
}